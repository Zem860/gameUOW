{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MongoDb": {
    "DatabaseName": "game"
  },
  "RateLimiting": {
    "GameStart": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "GameResult": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "AllowedHosts": "*"
}